#!/bin/sh
# Measures every sleep segment: length, share of time in deep sleep (S0ix),
# battery used and average watts. One journal line per segment (tag sleep-stats)
# and a CSV row in /var/lib/sleep-stats/history.csv, which sleep-window-update
# reads to size the instant-wake window (it uses columns 1-9 only).
# CSV: end_epoch,kind,seconds,deep_pct,cap_before,cap_after,watts,ac_before,ac_after,
#      s0i2.0_s,s0i2.1_s,s0i2.2_s,gpu_before/after,wake_irq,ec_flags(VIUF VGAT GC6S before>after),
#      soc_package_w,platform_psys_w (RAPL averages over the segment; -1 after hibernate)
# deep_pct comes from the PMC's SLP_S0 residency counter in debugfs, not from
# /sys/power/suspend_stats/total_hw_sleep: Linux 7.3 truncates each segment's
# hardware-sleep time to 32 bits of microseconds (intel/pmc/core.c,
# pmc_core_is_s0ix_failed), so any segment over 71.6 min was under-reported.
# A segment with under 80% deep sleep also gets a detail file in
# /var/lib/sleep-stats/details/ naming what blocked deep sleep.
B=/sys/class/power_supply/BAT1
AC=/sys/class/power_supply/ACAD/online
ST=/sys/power/suspend_stats
GPU=/sys/bus/pci/devices/0000:01:00.0/power/runtime_status
PMC=/sys/kernel/debug/pmc_core
RAPL=/sys/class/powercap
PRE=/run/sleep-stats.pre
DIR=/var/lib/sleep-stats

# EC RAM flags (ACPI ERAM = SystemMemory 0xFE108300, see docs/research/02):
#   VIUF byte 0x08 bit 1 - when 1, the dGPU _OFF skips POFF (rail stays powered)
#   VGAT byte 0x59 bit 2 - set by the dGPU power resource _ON, cleared by _OFF
#   GC6S byte 0xC0 bit 1
ecflags() {
    dd if=/dev/mem bs=256 count=1 iflag=skip_bytes skip=$((0xFE108300)) 2>/dev/null | od -An -v -tu1 | tr -s ' \n' ' ' |
        awk '{ printf "%d%d%d", int($9/2)%2, int($90/4)%2, int($193/2)%2 }'
}
# pmc0 substate residencies (microseconds): S0i2.0 S0i2.1 S0i2.2
subst() {
    awk '/^pmc1/ {exit} /S0i2\.[012]/ {printf "%s ", $2}' "$PMC/substate_residencies" 2>/dev/null
}
snap() {
    set -- $(subst)
    echo "$(date +%s) $(cat $B/charge_now) $(cat $B/voltage_now) $(cat $B/capacity) $(cat $AC) $(cat $PMC/slp_s0_residency_usec 2>/dev/null || echo 0) $(cat $ST/success) ${1:-0} ${2:-0} ${3:-0} $(cat $GPU 2>/dev/null || echo none) $(ecflags) $(cat $RAPL/intel-rapl:0/energy_uj 2>/dev/null || echo -1) $(cat $RAPL/intel-rapl:1/energy_uj 2>/dev/null || echo -1)"
}

case "$1" in
pre)
    snap > "$PRE"
    ;;
post)
    [ -f "$PRE" ] || exit 0
    read -r t0 c0 v0 p0 a0 h0 s0 r00 r10 r20 g0 e0 k0 q0 < "$PRE"
    now=$(snap)
    read -r t1 c1 v1 p1 a1 h1 s1 r01 r11 r21 g1 e1 k1 q1 <<SNAP
$now
SNAP
    rm -f "$PRE"
    kind=hibernate
    [ "$s1" -gt "$s0" ] && kind=suspend
    wake=$(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo -)
    line=$(awk -v t0="$t0" -v t1="$t1" -v c0="$c0" -v c1="$c1" -v v0="$v0" -v v1="$v1" \
               -v h0="$h0" -v h1="$h1" -v p0="$p0" -v p1="$p1" -v a0="$a0" -v a1="$a1" -v k="$kind" \
               -v r00="$r00" -v r01="$r01" -v r10="$r10" -v r11="$r11" -v r20="$r20" -v r21="$r21" \
               -v g="$g0/$g1" -v wk="$wake" -v ec="$e0>$e1" \
               -v k0="${k0:--1}" -v k1="${k1:--1}" -v q0="${q0:--1}" -v q1="${q1:--1}" \
               -v hmax="$(cat $ST/max_hw_sleep 2>/dev/null || echo 0)" \
               -v emax="$(cat $RAPL/intel-rapl:0/max_energy_range_uj 2>/dev/null || echo 0)" 'BEGIN {
        dt = t1 - t0; if (dt <= 0) exit
        dh = h1 - h0; if (dh < 0 && hmax > 0) dh += hmax
        deep = (k == "suspend") ? dh / 1e6 / dt * 100 : -1
        dk = k1 - k0; if (dk < 0) dk += emax
        dq = q1 - q0; if (dq < 0) dq += emax
        pk = (k == "suspend" && k0 >= 0 && k1 >= 0) ? dk / 1e6 / dt : -1
        ps = (k == "suspend" && q0 >= 0 && q1 >= 0) ? dq / 1e6 / dt : -1
        if (deep > 100) deep = 100
        wh = (c0 - c1) / 1e6 * (v0 + v1) / 2 / 1e6
        w = (a0 == 0 && a1 == 0) ? wh / (dt / 3600) : -1
        d0 = (k == "suspend" && r01 >= r00) ? (r01 - r00) / 1e6 : -1
        d1 = (k == "suspend" && r11 >= r10) ? (r11 - r10) / 1e6 : -1
        d2 = (k == "suspend" && r21 >= r20) ? (r21 - r20) / 1e6 : -1
        printf "%d,%s,%d,%.0f,%d,%d,%.2f,%d,%d,%.0f,%.0f,%.0f,%s,%s,%s,%.3f,%.3f", t1, k, dt, deep, p0, p1, w, a0, a1, d0, d1, d2, g, wk, ec, pk, ps }')
    [ -n "$line" ] || exit 0
    mkdir -p "$DIR"
    echo "$line" >> "$DIR/history.csv"
    echo "$line" | awk -F, '{
        h = int($3 / 3600); m = int(($3 % 3600) / 60)
        msg = sprintf("%s %dh%02dm: battery %d%% -> %d%%", $2, h, m, $5, $6)
        if ($4 >= 0) msg = msg sprintf(", deep sleep %d%% (S0i2.0 %ds, S0i2.1 %ds, S0i2.2 %ds)", $4, $10, $11, $12)
        if ($7 >= 0) msg = msg sprintf(", %.2f W average", $7); else msg = msg " (charger connected)"
        if ($16 >= 0) msg = msg sprintf(" (SoC package %.2f W, platform %.2f W by RAPL)", $16, $17)
        msg = msg sprintf(", GPU %s, woken by IRQ %s, EC VIUF/VGAT/GC6S %s", $13, $14, $15)
        print msg }' | logger -t sleep-stats

    # A bad segment: keep the evidence of what blocked deep sleep.
    deep=$(echo "$line" | cut -d, -f4)
    if [ "$kind" = suspend ] && [ "${deep:-100}" -lt 80 ] && [ "$(( t1 - t0 ))" -ge 60 ]; then
        f="$DIR/details/$t1.txt"
        mkdir -p "$DIR/details"
        {
            echo "segment: $line"
            echo "== wake IRQ $wake: $(grep -E "^ *$wake:" /proc/interrupts 2>/dev/null | awk '{print $NF, $(NF-1)}')"
            echo "== deeper-sleep requirements not met (latch: $(cat $PMC/lpm_latch_mode 2>/dev/null)):"
            awk -F'|' 'NR>1 { s=$5; gsub(/ /,"",s); if (s=="" && ($2 ~ /Required/ || $3 ~ /Required/ || $4 ~ /Required/)) print $1 "|" $2 "|" $3 "|" $4 }' "$PMC/substate_requirements" 2>/dev/null
            echo "== EC RAM (0xFE108300, 256 bytes):"; dd if=/dev/mem bs=256 count=1 iflag=skip_bytes skip=$((0xFE108300)) 2>/dev/null | od -Ax -tx1
            echo "== LTR:"; cat "$PMC/ltr_show" 2>/dev/null
            echo "== PCH IP power gating:"; cat "$PMC/pch_ip_power_gating_status" 2>/dev/null
            echo "== package C-states:"; cat "$PMC/package_cstate_show" 2>/dev/null
            echo "== PCI devices awake (runtime active):"
            for d in /sys/bus/pci/devices/*; do
                [ "$(cat "$d/power/runtime_status" 2>/dev/null)" = active ] && echo "${d##*/} $(cat "$d/class") driver=$(basename "$(readlink "$d/driver" 2>/dev/null)")"
            done
            echo "== USB devices awake:"
            for u in /sys/bus/usb/devices/*; do
                [ -f "$u/idVendor" ] && [ "$(cat "$u/power/runtime_status")" = active ] && echo "${u##*/} $(cat "$u/idVendor"):$(cat "$u/idProduct") $(cat "$u/product" 2>/dev/null)"
            done
            echo "== kernel log of the segment:"
            journalctl -k --since "@$t0" --until "@$t1" --no-pager -q 2>/dev/null | tail -150
        } > "$f" 2>&1
        logger -t sleep-stats "low deep sleep - details saved to $f"
    fi
    ;;
esac
exit 0
