[Unit]
Description=Game governor: every Proton game at its frame target with the least power it needs
Documentation=file:///usr/local/sbin/game-governor
After=asusd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/game-governor
Restart=on-failure
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
