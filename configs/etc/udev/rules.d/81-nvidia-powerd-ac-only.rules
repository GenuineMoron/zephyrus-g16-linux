# Run nvidia-powerd (NVIDIA Dynamic Boost) only on the charger. See
# /etc/systemd/system/nvidia-powerd.service.d/10-ac-only.conf.
SUBSYSTEM=="power_supply", KERNEL=="ACAD", ATTR{online}=="1", RUN+="/usr/bin/systemctl --no-block start nvidia-powerd.service"
SUBSYSTEM=="power_supply", KERNEL=="ACAD", ATTR{online}=="0", RUN+="/usr/bin/systemctl --no-block stop nvidia-powerd.service"
