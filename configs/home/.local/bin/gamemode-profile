#!/bin/sh
# gamemode start/end hook for the ASUS platform profile.
#   start: Performance (unlocks the GPU power ceiling + performance EPP), unless
#          the game asked for something else: gamemode-external leaves a hint in
#          $XDG_RUNTIME_DIR/gamemode-profile.hint ("<profile> [<balanced-epp>]")
#          from GAME_PROFILE / GAME_BALANCED_EPP in ~/.config/game-env/<appid>.env.
#          <balanced-epp> is asusd's EPP number for the Balanced profile
#          (1 performance, 2 balance_performance, 3 balance_power, 4 power).
#   end:   restore Balanced's EPP if it was changed, then go back to the profile
#          asusd uses for the CURRENT power source (AC or battery).
HINT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gamemode-profile.hint
SAVED=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gamemode-profile.saved-epp
EPP_PROP="xyz.ljones.Asusd /xyz/ljones xyz.ljones.Platform ProfileBalancedEpp"

case "$1" in
start)
    profile=Performance epp=
    [ -r "$HINT" ] && read -r profile epp < "$HINT"
    if [ -n "$epp" ]; then
        busctl --system get-property $EPP_PROP 2>/dev/null | awk '{print $2}' > "$SAVED"
        busctl --system set-property $EPP_PROP u "$epp"
    fi
    exec asusctl profile set "${profile:-Performance}" ;;
end)
    if [ -s "$SAVED" ]; then
        busctl --system set-property $EPP_PROP u "$(cat "$SAVED")"
        rm -f "$SAVED"
    fi
    if [ "$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)" = 1 ]; then key="AC profile"; else key="Battery profile"; fi
    p=$(asusctl profile get 2>/dev/null | sed -n "s/^$key //p")
    exec asusctl profile set "${p:-Balanced}" ;;
esac
