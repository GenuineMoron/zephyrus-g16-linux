#!/bin/sh
# mpv with Vulkan limited to the Intel GPU (zephyrus repo, research/37).
# Listing Vulkan devices loads NVIDIA's driver, which powers up the sleeping
# RTX 4070 (~2 s, then idle drain) although mpv renders on the Intel GPU that
# drives the screen. Vulkan is needed for HDR on Umbriel (OpenGL can't tag PQ).
# To use the RTX 4070 anyway: VK_DRIVER_FILES= mpv ...   (empty = all drivers)
if [ -z "${VK_DRIVER_FILES+set}" ]; then
    export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json
fi
[ -n "$VK_DRIVER_FILES" ] || unset VK_DRIVER_FILES
exec /usr/bin/mpv "$@"
