// Zed settings: quiet, clean defaults that match the desktop.
// Full reference: https://zed.dev/docs/configuring-zed
{
  // Follow the desktop's light/dark mode.
  "theme": { "mode": "system", "light": "One Light", "dark": "One Dark" },
  "icon_theme": "Zed (Default)",

  // Same fonts as the rest of the desktop.
  "ui_font_family": "Inter",
  "ui_font_size": 15,
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",

  // Calm editing surface.
  "soft_wrap": "editor_width",
  "show_whitespaces": "selection",
  "cursor_blink": false,
  "current_line_highlight": "gutter",
  "scrollbar": { "show": "auto" },
  "minimap": { "show": "never" },
  "tab_bar": { "show_nav_history_buttons": false },
  "toolbar": { "quick_actions": false },
  "autosave": "on_focus_change",
  "restore_on_startup": "last_session",

  // Markdown: wrap prose and keep the preview a keystroke away.
  "languages": {
    "Markdown": { "soft_wrap": "editor_width", "remove_trailing_whitespace_on_save": false }
  },

  // No usage data leaves the machine.
  "telemetry": { "diagnostics": false, "metrics": false }
}
