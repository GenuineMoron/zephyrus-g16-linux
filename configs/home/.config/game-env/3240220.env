# Grand Theft Auto V Enhanced (3240220), story mode (online needs BattlEye, which
# Rockstar doesn't enable on Linux). Start at a steady 60 (capped with
# VKD3D_FRAME_RATE=60 in the Steam launch options); raise to 80 if a measured
# session shows headroom. In game: Frame Scaling = NVIDIA DLSS (Quality),
# ray tracing at High rather than Maximum.
GAME_FPS_TARGET_AC=60
