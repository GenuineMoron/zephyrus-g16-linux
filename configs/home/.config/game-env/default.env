# Defaults for game-governor (see /usr/local/sbin/game-governor). A game's own
# ~/.config/game-env/<SteamAppId>.env is read after this and overrides it.
# Only GAME_* keys are read. Launch settings (Proton/DXVK env) belong in
# ~/.config/environment.d/57-proton-game-defaults.conf or the game's Steam
# launch options instead.
#
# Frame target: without VRR the 240 Hz panel paces evenly at 60, 80 or 120.
GAME_FPS_TARGET_AC=120
GAME_FPS_TARGET_BATTERY=60
# auto: start efficient (Balanced + balance_performance CPU), Performance only
# while the target is missed and Performance measurably helps.
# fixed: GAME_PROFILE for the whole session. off: leave the game alone.
GAME_GOVERNOR=auto
# Optional: cap the CPU's top boost (MHz) while efficient, e.g. 4200.
#GAME_CPU_MAX_MHZ=4200
