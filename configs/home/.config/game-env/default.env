# Defaults for every game started through ~/.local/bin/gamemode-external
# (Steam launch options: gamemode-external %command%). A game's own file,
# ~/.config/game-env/<SteamAppId>.env, is read after this one and overrides it.
#
# Frame target. Without VRR the 240 Hz panel paces evenly only at divisors of
# 240 (60, 80, 120). Frames beyond the target are heat and fan noise.
GAME_FPS_TARGET_AC=120
GAME_FPS_TARGET_BATTERY=60
# 1: cap Proton games at the target with DXVK/VKD3D's own limiters.
# 0: leave it to the game (use when the game caps itself).
GAME_FRAME_LIMIT=1
# auto: start efficient (Balanced fans, balance_performance CPU) and let
#       game-governor switch to Performance only while the target is missed
#       and Performance actually helps.
# fixed: use GAME_PROFILE (and GAME_BALANCED_EPP) for the whole session.
GAME_GOVERNOR=auto
# Render on the RTX 4070 (the Intel GPU only displays).
__NV_PRIME_RENDER_OFFLOAD=1
__VK_LAYER_NV_optimus=NVIDIA_only
# NVIDIA 620 + PRIME on Umbriel: VKD3D-Proton's VK_EXT_present_timing path breaks
# presentation (white window on Xwayland, swapchain crash on Wayland), seen with
# Elden Ring 2026-11-17. Disabling the optional extension fixed it; DX12 only.
VKD3D_DISABLE_EXTENSIONS=VK_EXT_present_timing
# Optional: cap the CPU's top boost (MHz) while the governor is efficient, e.g.
# GAME_CPU_MAX_MHZ=4200. The last boost steps cost the most heat for the least
# speed. Off by default until measured per game.
#GAME_CPU_MAX_MHZ=4200
