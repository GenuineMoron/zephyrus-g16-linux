# ELDEN RING (1245620). Read by ~/.local/bin/gamemode-external at launch.
# 2026-11-17: under Xwayland the game stalled on a white window (GPU idle at
# P8 with 1.4 GB allocated). Under native Wayland, VKD3D-Proton failed to
# create its swapchain (vr -13) and crashed in vkGetPastPresentationTimingEXT.
# vkcube presents fine on the NVIDIA GPU both ways, so the suspect is the new
# VK_EXT_present_timing path (NVIDIA 620 + PRIME); disable it for VKD3D.
PROTON_ENABLE_WAYLAND=1
# Keep NVIDIA's shader cache across updates and sessions (it was empty, so
# shaders compiled mid-game: one 113 ms hitch in a 2-minute test).
__GL_SHADER_DISK_CACHE_SIZE=10737418240
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
# Elden Ring caps itself at 60 fps: the governor targets 60, and the game's own
# limiter stays in charge (measured smooth: 59.2-59.9 fps).
GAME_FPS_TARGET_AC=60
GAME_FRAME_LIMIT=0
# Governor auto (the default): starts in Balanced + balance_performance, which held
# 60 fps in a busy area (2026-11-17), and boosts to Performance only if needed.
