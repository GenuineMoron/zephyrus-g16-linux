# Arch's libdisplay-info 0.3.0 PKGBUILD plus one patch: detect HDR from
# DisplayID 2.0 data blocks, so wlroots compositors (Umbriel) offer HDR on
# panels that declare it only there (the G16's Samsung ATNA60DL01 OLED).
# Same ABI as the stock package. Drop this package once libdisplay-info ships
# upstream MR 210 (plus the luminance part) and Arch/CachyOS update.
# Revert: sudo pacman -U /var/cache/pacman/pkg/libdisplay-info-0.3.0-1.1-x86_64_v3.pkg.tar.zst
# Original maintainers: Caleb Maclennan, Simon Ser (Arch packaging)

pkgname=libdisplay-info
pkgver=0.3.0
pkgrel=1.3
pkgdesc='EDID and DisplayID library (+ DisplayID 2.0 HDR detection backport)'
url="https://gitlab.freedesktop.org/emersion/$pkgname"
arch=(x86_64)
license=(MIT)
depends=(glibc)
makedepends=(hwdata
             meson
             ninja
             python)
provides=(libdisplay-info.so)
_archive="$pkgname-$pkgver"
# The tarball is pinned by Arch's checksum (its .sig is not checked here).
source=("$url/-/releases/$pkgver/downloads/$_archive.tar.xz"
        0001-info-detect-HDR-from-DisplayID-2.0-data-blocks.patch)
sha256sums=('6ae77cd937f9cf7d1321d35c116062c4911e8447010a6a713ac4286f7a9d5987'
            '2bf6cb9228704b2b910d5d2f12aa30f2da98b3ee039179acce69ed587ee62796')

prepare() {
	patch -d "$_archive" -Np1 < 0001-info-detect-HDR-from-DisplayID-2.0-data-blocks.patch
}

build() {
	arch-meson "$_archive" build
	ninja -C build
}

check() {
	meson test -C build --no-rebuild --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_archive/LICENSE"
}
